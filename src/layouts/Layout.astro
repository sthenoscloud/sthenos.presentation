---
const { title, description = "Platform Demonstration" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.cdnfonts.com/css/d-din" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --space-black: #000000;
    --spectral-white: #f0f0fa;
    --ghost-surface: rgba(240, 240, 250, 0.1);
    --ghost-border: rgba(240, 240, 250, 0.35);
    --dark-overlay: rgba(0, 0, 0, 0.5);
    --white-100: #ffffff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    font-family: 'D-DIN', Arial, Verdana, sans-serif;
    background: var(--space-black);
    color: var(--spectral-white);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    line-height: 1.6;
  }

  a { color: var(--spectral-white); text-decoration: none; }
  a:hover { color: var(--white-100); }

  /* NAV */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 24px;
    padding: 24px 5%;
    z-index: 100;
    background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 100%);
  }

  nav a {
    text-transform: uppercase;
    letter-spacing: 1.17px;
    font-size: 13px;
    font-weight: 700;
  }

  nav a:hover {
    opacity: 0.8;
  }

  /* SECTION */
  .section {
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    align-items: center;
    padding: 80px 5%;
  }

  .section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--dark-overlay);
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }

  /* TYPOGRAPHY */
  h1 {
    font-size: 48px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.96px;
    line-height: 1;
    margin-bottom: 24px;
  }

  h2 {
    font-size: 32px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.96px;
    margin-bottom: 18px;
  }

  h3 {
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.96px;
    margin-bottom: 12px;
  }

  p {
    font-size: 16px;
    line-height: 1.7;
    max-width: 540px;
  }

  /* GHOST BUTTON */
  .ghost-btn {
    display: inline-block;
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    border-radius: 32px;
    padding: 18px 32px;
    color: var(--spectral-white);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.17px;
    font-size: 13px;
    font-weight: 700;
    margin-top: 32px;
    transition: background 0.2s;
  }

  .ghost-btn:hover {
    background: rgba(240, 240, 250, 0.2);
    color: var(--white-100);
  }

  /* LABEL */
  .label {
    font-size: 10px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
    margin-bottom: 16px;
  }

  /* GRID */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px;
    margin-top: 48px;
  }

  .grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  /* STATS */
  .stats {
    display: flex;
    gap: 48px;
    margin-top: 48px;
    flex-wrap: wrap;
  }

  .stat-value {
    font-size: 48px;
    font-weight: 700;
    letter-spacing: 0.96px;
  }

  .stat-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.6;
    margin-top: 8px;
  }

  /* PIPELINE FLOW */
  .pipeline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .pipeline-stage {
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .pipeline-arrow {
    opacity: 0.5;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    h1 { font-size: 32px; }
    h2 { font-size: 24px; }
    .grid, .grid-3 { grid-template-columns: 1fr; }
    .stats { gap: 32px; }
    nav { gap: 16px; }
    nav a { font-size: 11px; }
  }
</style>