---
import Layout from '../layouts/Layout.astro';

const { title, subtitle = "", files = 0, classes = 0, functions = 0, edges = 0 } = Astro.props;

const stats = [
  { label: 'Files', value: files },
  { label: 'Classes', value: classes },
  { label: 'Functions', value: functions },
  { label: 'Edges', value: edges },
];
---

<Layout title={title}>
  <nav>
    <a href="/">Sthenos</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/drill">Drill</a>
  </nav>

  <section class="section" style="background-image: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=80');">
    <div class="content">
      <p class="label">Architecture Documentation</p>
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
      <div class="stats">
        {stats.filter(s => s.value > 0).map(stat => (
          <div>
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="nav-breadcrumb">
      <slot />
    </div>
  </section>
</Layout>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 32px;
    padding: 24px 5%;
    z-index: 100;
    background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
  }

  nav a {
    text-transform: uppercase;
    letter-spacing: 1.17px;
    font-size: 12px;
    font-weight: 700;
  }

  .content-section {
    background: var(--space-black);
    padding: 80px 5%;
    min-height: 60vh;
  }

  .nav-breadcrumb {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .nav-breadcrumb a {
    padding: 8px 16px;
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    border-radius: 20px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--spectral-white);
    text-decoration: none;
    transition: all 0.2s;
  }

  .nav-breadcrumb a:hover {
    background: rgba(240, 240, 250, 0.2);
  }

  @media (max-width: 768px) {
    nav { gap: 16px; }
    nav a { font-size: 10px; }
  }
</style>