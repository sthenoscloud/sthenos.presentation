---
import Layout from '../layouts/Layout.astro';
---

<script>
// Auth check
if (!sessionStorage.getItem('sthenos_auth')) {
  window.location.href = '/';
}
</script>

<Layout title="Dashboard - Sthenos">
  <nav>
    <a href="/">Sthenos</a>
    <a href="#capabilities">Capabilities</a>
    <a href="#architecture">Architecture</a>
    <a href="#scenarios">Scenarios</a>
    <a href="#dynamics">Dynamics</a>
    <a href="/drill">Drill</a>
    <a href="/analysis">Analysis</a>
  </nav>

  <!-- HERO SECTION -->
  <section class="section" style="background-image: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=80');">
    <div class="content">
      <p class="label">Platform Dashboard</p>
      <h1>Observe → Understand → Anticipate</h1>
      <p>A three-layer behavioral early-warning system. Not tracking. Not anomaly detection. Regime-aware inference.</p>
      <div class="stats">
        <div>
          <div class="stat-value">118</div>
          <div class="stat-label">Entities Processed</div>
        </div>
        <div>
          <div class="stat-value">398</div>
          <div class="stat-label">Timesteps Analyzed</div>
        </div>
        <div>
          <div class="stat-value">46K+</div>
          <div class="stat-label">Entity-Tick Observations</div>
        </div>
        <div>
          <div class="stat-value">0.998</div>
          <div class="stat-label">Signal Confidence</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES SECTION -->
  <section id="capabilities" class="section" style="background-image: url('https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1920&q=80');">
    <div class="content">
      <p class="label">Core Capabilities</p>
      <h2>The Platform</h2>
      <p>sthenos.cloud transforms incomplete operational datasets (raw movement traces, geometry) into actionable simulation environments for defense AI. The L3 MVP core produces WISDOM-aligned JSON with decision traces.</p>

      <div class="grid">
        <div>
          <h3>1. Observe</h3>
          <p>Raw movement → Operational interaction picture. Multi-agent trajectories, spatial relationships, temporal evolution.</p>
        </div>
        <div>
          <h3>2. Understand</h3>
          <p>Behavioral intelligence. Coordination indicators, instability indicators, role inference (scout/attacker/defender), pressure distribution.</p>
        </div>
        <div>
          <h3>3. Anticipate</h3>
          <p>Regime transition detection. Stability assessment, transition detection, escalation precursors, decision support cues.</p>
        </div>
        <div>
          <h3>Pipeline</h3>
          <div class="pipeline">
            <span class="pipeline-stage">Ingest</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-stage">Enrich</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-stage">Infer</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-stage">Classify</span>
            <span class="pipeline-arrow">→</span>
            <span class="pipeline-stage">Signal</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE SECTION -->
  <section id="architecture" class="section" style="background-image: url('https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?w=1920&q=80');">
    <div class="content">
      <p class="label">System Architecture</p>
      <h2>7-Layer Defense AI Platform</h2>

      <div class="layer-list">
        <div class="layer-item">
          <span class="layer-num">L1</span>
          <span>Raw Inputs (Caldera / Sensors / IoT / Edge)</span>
        </div>
        <div class="layer-item">
          <span class="layer-num">L2</span>
          <span>Data Normalization (USD / JSON / Streams)</span>
        </div>
        <div class="layer-item core">
          <span class="layer-num">L3</span>
          <span>Semantic Enrichment Layer — Core MVP</span>
        </div>
        <div class="layer-item">
          <span class="layer-num">L4</span>
          <span>Behavioral & Tactical Modeling</span>
        </div>
        <div class="layer-item">
          <span class="layer-num">L5</span>
          <span>Synthetic Data Generation Engine</span>
        </div>
        <div class="layer-item">
          <span class="layer-num">L6</span>
          <span>Decision Support & Scenario Evaluation</span>
        </div>
        <div class="layer-item">
          <span class="layer-num">L7</span>
          <span>Strategic AI / Multi-agent Simulation</span>
        </div>
      </div>

      <div class="grid" style="margin-top: 64px;">
        <div>
          <h3>Component Modules</h3>
          <div class="module-grid">
            <span class="module-tag" style="border-color: #6366f1;">Core</span>
            <span class="module-tag" style="border-color: #10b981;">Enrichment</span>
            <span class="module-tag" style="border-color: #f59e0b;">Ingestion</span>
            <span class="module-tag" style="border-color: #ef4444;">IO</span>
            <span class="module-tag" style="border-color: #8b5cf6;">Pipeline</span>
            <span class="module-tag" style="border-color: #ec4899;">Roles</span>
          </div>
        </div>
        <div>
          <h3>Key Differentiators</h3>
          <ul class="feature-list">
            <li>Terrain-aware reasoning (canonical world frame)</li>
            <li>Dual-path inference (static + streaming)</li>
            <li>Causal evaluation layer (D-effector)</li>
            <li>Air-gap operable (no external network calls)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SCENARIOS SECTION -->
  <section id="scenarios" class="section" style="background-image: url('https://images.unsplash.com/photo-1614728423169-3f65fd72e207?w=1920&q=80');">
    <div class="content">
      <p class="label">Operational Scenarios</p>
      <h2>Degraded Conditions</h2>
      <p>Capabilities that cannot operate under degraded conditions are laboratory curiosities. These scenarios represent the operational envelope.</p>

      <div class="scenario-grid">
        <div class="scenario-card">
          <p class="scenario-label">Fog of War</p>
          <h3>Partial Visibility Engagement</h3>
          <p>40% sensor coverage, intermittent thermal signatures. Sparse Detection → Trajectory Imputation → Feature Enrichment → Streaming Inference → Role Classification → Confidence Tagging.</p>
          <div class="scenario-output">
            <span>2 entities (SCOUT)</span>
            <span>0.58 confidence</span>
            <span>~180ms</span>
          </div>
        </div>
        <div class="scenario-card">
          <p class="scenario-label">Edge Compute</p>
          <h3>Night Vision Integration</h3>
          <p>Embedded in helmet NVGs + drone ISR + edge compute. No cloud, <100ms latency required. Thermal Feed → On-device Ingestion → Local Inference → HUD Overlay.</p>
          <div class="scenario-output">
            <span>30Hz real-time</span>
            <span>ATTACKER/SCOUT/DEFEND</span>
            <span>2s prediction</span>
          </div>
        </div>
        <div class="scenario-card">
          <p class="scenario-label">Disconnected</p>
          <h3>No C2 - Full Autonomy</h3>
          <p>Communication denial, local decision authority required. Local Sensor Feed → Offline Enrichment → Autonomous Inference → Decision Recommendation + Confidence + Risk.</p>
          <div class="scenario-output">
            <span>ENGAGE/OBSERVE/REPOSITION</span>
            <span>Per-route scoring</span>
            <span>Conservative bias</span>
          </div>
        </div>
        <div class="scenario-card">
          <p class="scenario-label">Live ISR</p>
          <h3>Drone Stream Analysis</h3>
          <p>Streaming behavioral engine → operator guidance. <150ms aerial-to-decision. Drone Feed → Streaming Behavioral Engine → Role Classification → Threat Estimation → Map Overlay.</p>
          <div class="scenario-output">
            <span>~95ms</span>
            <span>HIGH priority alert</span>
            <span>120m force disposition</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DYNAMICS SECTION -->
  <section id="dynamics" class="section" style="background-image: url('https://images.unsplash.com/photo-1465101162946-4377e57745c3?w=1920&q=80');">
    <div class="content">
      <p class="label">System Dynamics</p>
      <h2>Feedback & Stability</h2>
      <p>The system exhibits temporal behaviors: feedback loops, stream/batch divergence, convergence zones, and instability triggers.</p>

      <div class="dynamics-grid">
        <div class="dynamics-item">
          <h3>Feedback Loops</h3>
          <p>Evaluation → pipeline recalibration creates positive loop. Model improvements enhance evaluation accuracy.</p>
        </div>
        <div class="dynamics-item">
          <h3>Stream/Batch Divergence</h3>
          <p>EMA-based normalization diverges from static features over time. Monitoring required for long-running sessions.</p>
        </div>
        <div class="dynamics-item">
          <h3>Convergence Zones</h3>
          <p>Static features stabilize after ~50 entities. Latency bounded at P95 < 500ms for 100 entities.</p>
        </div>
        <div class="dynamics-item">
          <h3>Instability Triggers</h3>
          <p>Novel scenarios break rule thresholds. Rule brittleness + metric illusion risk on synthetic data.</p>
        </div>
      </div>

      <div style="margin-top: 64px;">
        <h3>Evaluation Metrics</h3>
        <div class="eval-stats">
          <div>
            <div class="stat-value">167</div>
            <div class="stat-label">Test Files</div>
          </div>
          <div>
            <div class="stat-value">34</div>
            <div class="stat-label">Classes</div>
          </div>
          <div>
            <div class="stat-value">156</div>
            <div class="stat-label">Edges</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUE FLOW SECTION -->
  <section class="section" style="background-image: url('https://images.unsplash.com/photo-1506318137071-a8e063b4bec0?w=1920&q=80');">
    <div class="content">
      <p class="label">Value Flow</p>
      <h2>Data to Intelligence</h2>
      <p>Value propagates through five stages. Each transformation increases confidence and reduces uncertainty for decision-makers.</p>

      <div class="pipeline-full">
        <div class="pipe-stage">
          <span class="pipe-num">01</span>
          <span>Raw Trajectories</span>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-stage">
          <span class="pipe-num">02</span>
          <span>Structured Signals</span>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-stage">
          <span class="pipe-num">03</span>
          <span>Behavioral Patterns</span>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-stage">
          <span class="pipe-num">04</span>
          <span>Role Attribution</span>
        </div>
        <span class="pipe-arrow">→</span>
        <div class="pipe-stage">
          <span class="pipe-num">05</span>
          <span>Strategic Insight</span>
        </div>
      </div>

      <div class="grid" style="margin-top: 64px;">
        <div>
          <h3>Confidence Growth</h3>
          <p>Uncertainty decreases as data flows through pipeline. Raw data: low confidence. Strategic insight: high confidence.</p>
        </div>
        <div>
          <h3>Latency Budget</h3>
          <p>Ingestion is variable; enrichment and pattern detection are bounded. Signal generation is deterministic.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAILURE MODES SECTION -->
  <section class="section" style="background-image: url('https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?w=1920&q=80');">
    <div class="content">
      <p class="label">Risk Assessment</p>
      <h2>Failure Modes</h2>
      <p>Understanding where the system fails is as important as understanding what it does.</p>

      <div class="fail-grid">
        <div class="fail-item critical">
          <h3>Data Sparsity</h3>
          <p>Incomplete breadcrumbs propagate through all downstream stages. 5% location error → 20% behavioral misclassification.</p>
        </div>
        <div class="fail-item">
          <h3>Terrain Mis-modeling</h3>
          <p>Terrain cost field inaccuracies → suboptimal path inference.</p>
        </div>
        <div class="fail-item">
          <h3>Misclassification</h3>
          <p>Static/streaming divergence → entity role errors.</p>
        </div>
        <div class="fail-item">
          <h3>Rule Brittleness</h3>
          <p>Rule thresholds fail on novel tactical scenarios.</p>
        </div>
        <div class="fail-item warning">
          <h3>Metric Illusion</h3>
          <p>F1 > 70% achieved on synthetic data. Real operational performance unknown.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATION SECTION -->
  <section class="section" style="background-image: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1920&q=80');">
    <div class="content">
      <p class="label">Competitive Position</p>
      <h2>Differentiation</h2>
      <p>Four capabilities represent our defensible differentiators — technically difficult to replicate and providing measurable operational advantage.</p>

      <div class="diff-grid">
        <div class="diff-item">
          <span class="diff-num">01</span>
          <h3>Terrain-Aware Reasoning</h3>
          <p>Canonical world frame + cost field propagation. Competitors use simple distance metrics; we model actual traversability.</p>
        </div>
        <div class="diff-item">
          <span class="diff-num">02</span>
          <h3>Dual-Path Inference</h3>
          <p>Only system with parallel static + streaming behavioral inference. Enables both retrospective analysis and live tracking.</p>
        </div>
        <div class="diff-item">
          <span class="diff-num">03</span>
          <h3>Causal Evaluation</h3>
          <p>D-effector + critically damped controller for stable, accurate evaluation.</p>
        </div>
        <div class="diff-item">
          <span class="diff-num">04</span>
          <h3>Air-Gap Operable</h3>
          <p>No external network dependencies. Deployable in classified environments. Competitors require cloud connectivity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LOGOUT -->
  <div class="logout-section">
    <a href="/" id="signOut" class="ghost-btn">Sign Out</a>

<script>
document.getElementById('signOut')?.addEventListener('click', (e) => {
  e.preventDefault();
  sessionStorage.removeItem('sthenos_auth');
  window.location.href = '/';
});
</script>
    <p class="classification">UNCLASSIFIED // FOR DEMONSTRATION ONLY</p>
    <p class="ownership-notice">The domain <strong>sthenos.cloud</strong> and all associated site content are held in trust and will be transferred to the rightful owner(s) of Sthenos AI upon request — instantly and without condition. All information is kept private and confidential.</p>
  </div>
</Layout>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 32px;
    padding: 24px 5%;
    z-index: 100;
    background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
  }

  nav a {
    text-transform: uppercase;
    letter-spacing: 1.17px;
    font-size: 12px;
    font-weight: 700;
  }

  nav a:hover {
    opacity: 0.7;
  }

  /* LAYER LIST */
  .layer-list {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .layer-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(240, 240, 250, 0.1);
  }

  .layer-item.core {
    border: 1px solid var(--ghost-border);
    border-radius: 8px;
    padding: 12px 16px;
    background: rgba(99, 102, 241, 0.1);
  }

  .layer-num {
    font-size: 10px;
    font-weight: 700;
    opacity: 0.5;
    min-width: 24px;
  }

  /* MODULE GRID */
  .module-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }

  .module-tag {
    padding: 8px 16px;
    border: 1px solid;
    border-radius: 20px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* FEATURE LIST */
  .feature-list {
    list-style: none;
    margin-top: 16px;
  }

  .feature-list li {
    padding: 8px 0;
    border-bottom: 1px solid rgba(240, 240, 250, 0.1);
    font-size: 14px;
  }

  /* SCENARIO GRID */
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 48px;
  }

  .scenario-card {
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    border-radius: 16px;
    padding: 32px;
  }

  .scenario-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.6;
    margin-bottom: 12px;
  }

  .scenario-card h3 {
    margin-bottom: 12px;
  }

  .scenario-card p {
    font-size: 14px;
    opacity: 0.8;
    margin-bottom: 24px;
  }

  .scenario-output {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .scenario-output span {
    font-size: 11px;
    padding: 6px 12px;
    background: rgba(240, 240, 250, 0.1);
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* DYNAMICS GRID */
  .dynamics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 48px;
  }

  .dynamics-item {
    padding: 24px;
    border: 1px solid rgba(240, 240, 250, 0.1);
    border-radius: 8px;
  }

  .dynamics-item h3 {
    font-size: 14px;
    margin-bottom: 12px;
  }

  .dynamics-item p {
    font-size: 14px;
    opacity: 0.7;
  }

  /* EVAL STATS */
  .eval-stats {
    display: flex;
    gap: 48px;
    margin-top: 24px;
  }

  /* PIPELINE FULL */
  .pipeline-full {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
    flex-wrap: wrap;
  }

  .pipe-stage {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    border-radius: 8px;
    padding: 16px 20px;
  }

  .pipe-num {
    font-size: 10px;
    opacity: 0.5;
  }

  .pipe-arrow {
    opacity: 0.4;
  }

  /* FAIL GRID */
  .fail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .fail-item {
    padding: 24px;
    border: 1px solid rgba(240, 240, 250, 0.1);
    border-radius: 8px;
  }

  .fail-item.critical {
    border-color: rgba(239, 68, 68, 0.5);
    background: rgba(239, 68, 68, 0.1);
  }

  .fail-item.warning {
    border-color: rgba(245, 158, 11, 0.5);
    background: rgba(245, 158, 11, 0.1);
  }

  .fail-item h3 {
    font-size: 14px;
    margin-bottom: 12px;
  }

  .fail-item p {
    font-size: 13px;
    opacity: 0.7;
  }

  /* DIFF GRID */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 48px;
  }

  .diff-item {
    position: relative;
    padding-left: 64px;
  }

  .diff-num {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 32px;
    font-weight: 700;
    opacity: 0.2;
  }

  .diff-item h3 {
    font-size: 16px;
    margin-bottom: 12px;
  }

  .diff-item p {
    font-size: 14px;
    opacity: 0.7;
  }

  /* LOGOUT SECTION */
  .logout-section {
    padding: 80px 5%;
    text-align: center;
    background: var(--space-black);
  }

  .classification {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.4;
    margin-top: 32px;
  }

  .ownership-notice {
    font-size: 11px;
    opacity: 0.6;
    margin-top: 16px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
    border-left: 2px solid rgba(240, 240, 250, 0.3);
    padding-left: 12px;
    text-align: left;
    color: rgba(240, 240, 250, 0.8);
  }

  .ownership-notice strong {
    color: var(--spectral-white);
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    nav { gap: 16px; }
    nav a { font-size: 10px; }
    h1 { font-size: 32px; }
    h2 { font-size: 24px; }
    .grid, .scenario-grid, .dynamics-grid, .fail-grid, .diff-grid { grid-template-columns: 1fr; }
    .pipeline-full { flex-direction: column; align-items: flex-start; }
    .stats { gap: 24px; }
  }
</style>