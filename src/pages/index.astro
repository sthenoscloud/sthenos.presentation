---
import Layout from '../layouts/Layout.astro';
---

<script>
async function hashPassword(password: string): Promise<string> {
  const msgBuffer = new TextEncoder().encode(password);
  const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
}

const form = document.getElementById('loginForm');
const errorMsg = document.getElementById('errorMsg');

// SHA-256 hash of "demo123"
const adminHash = 'd3ad9315b7be5dd53b31a273b3b3aba5defe700808305aa16a3062b76658a791';

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const username = (document.getElementById('username') as HTMLInputElement).value;
  const password = (document.getElementById('password') as HTMLInputElement).value;

  if (username === 'admin' && await hashPassword(password) === adminHash) {
    window.location.href = '/dashboard';
  } else {
    errorMsg.textContent = 'Access denied. Contact administrator.';
  }
});
</script>

<Layout title="Platform Demonstration - Sthenos">
  <nav>
    <a href="#">Sthenos</a>
  </nav>

  <section class="section" style="background-image: url('https://images.unsplash.com/photo-1516849841032-87cbac4d0383?w=1920&q=80');">
    <div class="content">
      <p class="label">Platform Demonstration</p>
      <h1>7-Layer Defense AI</h1>
      <p>Transform incomplete operational datasets into actionable simulation environments for defense AI. The L3 MVP core produces WISDOM-aligned JSON with decision traces.</p>
      <a href="/dashboard" class="ghost-btn">Enter Platform</a>
    </div>
  </section>
</Layout>

<style>
  .section {
    background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.7) 100%),
      url('https://images.unsplash.com/photo-1516849841032-87cbac4d0383?w=1920&q=80');
    background-size: cover;
    background-position: center;
  }

  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    padding: 24px 5%;
    z-index: 100;
  }

  nav a {
    text-transform: uppercase;
    letter-spacing: 1.17px;
    font-size: 13px;
    font-weight: 700;
    color: var(--spectral-white);
    text-decoration: none;
  }

  form {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 320px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .input-group label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .input-group input {
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    border-radius: 8px;
    padding: 16px;
    color: var(--spectral-white);
    font-family: 'D-DIN', Arial, Verdana, sans-serif;
    font-size: 16px;
    outline: none;
  }

  .input-group input::placeholder {
    color: rgba(240, 240, 250, 0.4);
  }

  .input-group input:focus {
    border-color: rgba(240, 240, 250, 0.6);
  }

  .btn-login {
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    border-radius: 32px;
    padding: 18px 32px;
    color: var(--spectral-white);
    text-transform: uppercase;
    letter-spacing: 1.17px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 16px;
    transition: background 0.2s;
    font-family: 'D-DIN', Arial, Verdana, sans-serif;
  }

  .btn-login:hover {
    background: rgba(240, 240, 250, 0.2);
  }

  .error {
    font-size: 12px;
    color: #ff6b6b;
    min-height: 20px;
  }

  .disclaimer {
    font-size: 11px;
    opacity: 0.5;
    margin-top: 48px;
    max-width: 400px;
    line-height: 1.6;
  }
</style>