---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sthenos Cloud - AI Backbone for Defense">
  <main>
    <nav class="nav">
      <div class="nav-content">
        <a href="/" class="logo">
          <svg width="32" height="32" viewBox="0 0 32 32">
            <rect width="32" height="32" rx="6" fill="#111"/>
            <text x="16" y="22" text-anchor="middle" fill="#3b82f6" font-size="18" font-weight="700">S</text>
          </svg>
          <span>Sthenos</span>
        </a>
        <div class="nav-links">
          <a href="#capabilities">Capabilities</a>
          <a href="#architecture">Architecture</a>
          <a href="#technology">Technology</a>
          <a href="#contact">Contact</a>
        </div>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-content">
        <div class="hero-badge">Defense-Grade AI Platform</div>
        <h1>AI Backbone for<br/>Next-Gen C2 Systems</h1>
        <p class="hero-subtitle">
          Transform incomplete operational datasets into actionable simulation environments.
          Enabling tactical scenario reconstruction, AI-assisted decision support, and
          synthetic operational data generation.
        </p>
        <div class="hero-actions">
          <a href="#capabilities" class="btn btn-primary">Explore Platform</a>
          <a href="#architecture" class="btn btn-secondary">View Architecture</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="grid-visual">
          <div class="grid-line horizontal"></div>
          <div class="grid-line horizontal"></div>
          <div class="grid-line horizontal"></div>
          <div class="grid-line vertical"></div>
          <div class="grid-line vertical"></div>
          <div class="grid-line vertical"></div>
          <div class="node node-1"></div>
          <div class="node node-2"></div>
          <div class="node node-3"></div>
          <div class="node node-4"></div>
          <div class="connection c1"></div>
          <div class="connection c2"></div>
          <div class="connection c3"></div>
        </div>
      </div>
    </section>

    <section id="capabilities" class="capabilities">
      <div class="section-header">
        <h2>Core Capabilities</h2>
        <p>Sthenos provides end-to-end behavioral early-warning and tactical intelligence</p>
      </div>
      <div class="capability-grid">
        <div class="capability-card">
          <div class="cap-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>Observe</h3>
          <p>Raw movement data converted into dynamic interaction graphs exposing relational structure invisible in raw tracks.</p>
        </div>
        <div class="capability-card">
          <div class="cap-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>Understand</h3>
          <p>Behavioral intelligence layer detecting coordination patterns, instability indicators, and regime transitions before they become visible.</p>
        </div>
        <div class="capability-card">
          <div class="cap-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h3>Anticipate</h3>
          <p>Regime transition detection providing early warning on coordination, escalation, and reorganization before events occur.</p>
        </div>
        <div class="capability-card">
          <div class="cap-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M3 9h18"/>
              <path d="M9 21V9"/>
            </svg>
          </div>
          <h3>Cloud Modernization</h3>
          <p>Seamless integration with existing ISR pipelines and sensor networks with offline-capable processing.</p>
        </div>
        <div class="capability-card">
          <div class="cap-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
            </svg>
          </div>
          <h3>Quantum Integration</h3>
          <p>Future-ready architecture designed for quantum computing workloads and advanced cryptographic operations.</p>
        </div>
        <div class="capability-card">
          <div class="cap-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
              <path d="M3.27 6.96L12 12.01l8.73-5.05"/>
              <path d="M12 22.08V12"/>
            </svg>
          </div>
          <h3>Synthetic Data Generation</h3>
          <p>Generate synthetic operational data for training and simulation scenarios with full behavioral fidelity.</p>
        </div>
      </div>
    </section>

    <section id="architecture" class="architecture">
      <div class="section-header">
        <h2>Unified Intelligence Architecture</h2>
        <p>Seven-layer defense AI platform with semantic enrichment at its core</p>
      </div>
      <div class="architecture-visual">
        <div class="layer layer-7">
          <span class="layer-label">L7</span>
          <div class="layer-content">Strategic AI / Multi-agent Simulation</div>
        </div>
        <div class="layer layer-6">
          <span class="layer-label">L6</span>
          <div class="layer-content">Decision Support & Scenario Evaluation</div>
        </div>
        <div class="layer layer-5">
          <span class="layer-label">L5</span>
          <div class="layer-content">Synthetic Data Generation Engine</div>
        </div>
        <div class="layer layer-4">
          <span class="layer-label">L4</span>
          <div class="layer-content">Behavioral & Tactical Modeling</div>
        </div>
        <div class="layer layer-3 core">
          <span class="layer-label">L3</span>
          <div class="layer-content">
            <strong>Semantic Enrichment Layer</strong>
            <span class="layer-desc">Critical gap filler - transforms raw breadcrumbs into simulation-ready entities</span>
          </div>
        </div>
        <div class="layer layer-2">
          <span class="layer-label">L2</span>
          <div class="layer-content">Data Normalization (USD / JSON / Streams)</div>
        </div>
        <div class="layer layer-1">
          <span class="layer-label">L1</span>
          <div class="layer-content">Raw Inputs (Caldera / Sensors / IoT / Edge)</div>
        </div>
      </div>
      <div class="architecture-note">
        <code>Layer N cannot import Layer N+1</code> — preserves modularity and independence
      </div>
    </section>

    <section class="metrics">
      <div class="metrics-grid">
        <div class="metric">
          <div class="metric-value">118</div>
          <div class="metric-label">Entities Processed</div>
        </div>
        <div class="metric">
          <div class="metric-value">398</div>
          <div class="metric-label">Timesteps Analyzed</div>
        </div>
        <div class="metric">
          <div class="metric-value">46K+</div>
          <div class="metric-label">Entity-Tick Observations</div>
        </div>
        <div class="metric">
          <div class="metric-value">99.8%</div>
          <div class="metric-label">Signal Confidence</div>
        </div>
      </div>
    </section>

    <section id="technology" class="technology">
      <div class="section-header">
        <h2>Technology Stack</h2>
        <p>Built for defense-grade requirements with offline capability</p>
      </div>
      <div class="tech-grid">
        <div class="tech-card">
          <h3>Python Core</h3>
          <p>Best for simulation, data pipelines, AI/ML integration, and OpenUSD bindings.</p>
          <div class="tech-tags">
            <span>pxr (USD)</span>
            <span>numpy</span>
            <span>pandas</span>
            <span>networkx</span>
            <span>fastapi</span>
          </div>
        </div>
        <div class="tech-card">
          <h3>Local LLM Ready</h3>
          <p>LM Studio integration path defined for behavior explanation, scenario reasoning, and rule validation.</p>
          <div class="tech-tags">
            <span>DeepSeek-Coder</span>
            <span>Gemma</span>
            <span>localhost:1234</span>
          </div>
        </div>
        <div class="tech-card">
          <h3>Simulation Platforms</h3>
          <p>Compatible with JTLS, JCATS, VBS3/VBS4, SWORD, and ONE SAF via HLA federation.</p>
          <div class="tech-tags">
            <span>JTLS</span>
            <span>JCATS</span>
            <span>VBS4</span>
            <span>HLA/RTI</span>
          </div>
        </div>
      </div>
    </section>

    <section class="problem-solution">
      <div class="section-header">
        <h2>The Problem We Solve</h2>
      </div>
      <div class="ps-content">
        <div class="ps-block problem">
          <h4>Current ISR Limitation</h4>
          <div class="ps-code">
<pre>Dataset: Activision Caldera OpenUSD

Provides:     Geometry | Movement traces | Camera endpoints
Excludes:     Logic | Intent | Tactical semantics</pre>
          </div>
          <p>Raw data alone cannot produce simulation. A semantic reconstruction layer is mandatory.</p>
        </div>
        <div class="ps-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="ps-block solution">
          <h4>Sthenos Solution</h4>
          <div class="ps-code">
<pre>Before: Weeks of manual SME work
After:  Minutes of automated inference

Result: 48-hour tactical reconstruction
        becomes real-time processing</pre>
          </div>
          <p>Semantic enrichment transforms raw breadcrumbs into WISDOM-compliant entity records.</p>
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="contact-content">
        <h2>Ready to Transform Your Operations?</h2>
        <p>Sthenos.cloud is built for defense organizations requiring tactical intelligence and early-warning capabilities.</p>
        <a href="mailto:sthenoscloud@gmail.com" class="btn btn-primary">Contact Us</a>
      </div>
    </section>

    <footer class="footer">
      <div class="footer-content">
        <div class="footer-brand">
          <svg width="24" height="24" viewBox="0 0 32 32">
            <rect width="32" height="32" rx="6" fill="#111"/>
            <text x="16" y="22" text-anchor="middle" fill="#3b82f6" font-size="18" font-weight="700">S</text>
          </svg>
          <span>Sthenos Cloud</span>
        </div>
        <div class="footer-text">
          <p>AI Backbone for Next-Gen C2 Systems</p>
          <p class="footer-classification">UNCLASSIFIED // FOR OFFICIAL USE ONLY</p>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(10, 10, 10, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text-primary);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding: 8rem 2rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-light);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
  }

  .btn-primary:hover {
    background: var(--accent-secondary);
    color: white;
  }

  .btn-secondary {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-light);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    border-color: var(--text-muted);
  }

  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .grid-visual {
    position: relative;
    width: 300px;
    height: 300px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .grid-line {
    position: absolute;
    background: var(--border);
  }

  .grid-line.horizontal {
    height: 1px;
    left: 0;
    right: 0;
  }

  .grid-line.horizontal:nth-child(1) { top: 25%; }
  .grid-line.horizontal:nth-child(2) { top: 50%; }
  .grid-line.horizontal:nth-child(3) { top: 75%; }

  .grid-line.vertical {
    width: 1px;
    top: 0;
    bottom: 0;
  }

  .grid-line.vertical:nth-child(4) { left: 25%; }
  .grid-line.vertical:nth-child(5) { left: 50%; }
  .grid-line.vertical:nth-child(6) { left: 75%; }

  .node {
    position: absolute;
    width: 16px;
    height: 16px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .node-1 { top: 20%; left: 30%; animation-delay: 0s; }
  .node-2 { top: 45%; left: 65%; animation-delay: 0.5s; }
  .node-3 { top: 70%; left: 25%; animation-delay: 1s; }
  .node-4 { top: 35%; left: 50%; animation-delay: 1.5s; }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .connection {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    transform-origin: left center;
  }

  .c1 { top: 22%; left: 32%; width: 80px; transform: rotate(15deg); }
  .c2 { top: 47%; left: 52%; width: 60px; transform: rotate(-25deg); }
  .c3 { top: 37%; left: 32%; width: 70px; transform: rotate(5deg); }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }

  .capabilities {
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .capability-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .capability-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .cap-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-tertiary);
    border-radius: 10px;
    margin-bottom: 1.5rem;
  }

  .cap-icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--accent);
  }

  .capability-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .capability-card p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .architecture {
    background: var(--bg-secondary);
    padding: 6rem 2rem;
  }

  .architecture .section-header h2 {
    color: var(--text-primary);
  }

  .architecture-visual {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .layer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: all 0.2s;
  }

  .layer:hover {
    border-color: var(--border-light);
  }

  .layer.core {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(96, 165, 250, 0.05));
    border-color: var(--accent);
  }

  .layer-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    background: rgba(59, 130, 246, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .layer-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .layer-content strong {
    font-size: 0.9375rem;
  }

  .layer-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .architecture-note {
    text-align: center;
    margin-top: 2rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .architecture-note code {
    background: var(--bg-tertiary);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
  }

  .metrics {
    padding: 4rem 2rem;
    background: var(--bg-primary);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .metrics-grid {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .metric {
    text-align: center;
  }

  .metric-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .metric-label {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  .technology {
    padding: 6rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .tech-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
  }

  .tech-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .tech-card p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tags span {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
    color: var(--text-secondary);
  }

  .problem-solution {
    background: var(--bg-secondary);
    padding: 6rem 2rem;
  }

  .problem-solution .section-header {
    max-width: 1200px;
    margin: 0 auto 3rem;
    text-align: left;
  }

  .ps-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .ps-block {
    flex: 1;
    padding: 2rem;
    border-radius: 12px;
  }

  .ps-block.problem {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .ps-block.solution {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .ps-block h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .ps-code {
    background: var(--bg-primary);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .ps-code pre {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .ps-block p {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .ps-arrow svg {
    width: 32px;
    height: 32px;
    stroke: var(--accent);
    flex-shrink: 0;
  }

  .contact {
    padding: 6rem 2rem;
    text-align: center;
  }

  .contact-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-content h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .contact-content p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .footer {
    padding: 3rem 2rem;
    border-top: 1px solid var(--border);
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
  }

  .footer-text {
    text-align: right;
  }

  .footer-text p {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .footer-classification {
    font-size: 0.75rem !important;
    color: var(--text-muted) !important;
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
    }

