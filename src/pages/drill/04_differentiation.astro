---
import Layout from '../../layouts/Layout.astro';
---

<script>
if (!sessionStorage.getItem('sthenos_auth')) {
  window.location.href = '/';
}
</script>

<Layout title="Differentiation - Sthenos">
  <nav>
    <a href="/">Sthenos</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/drill">Drill</a>
  </nav>

  <section class="section" style="background-image: url('https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=1920&q=80');">
    <div class="content">
      <p class="label">04_differentiation.html</p>
      <h1>Competitive Differentiation</h1>
      <p>The defensible technical advantages that create strategic value. These four capabilities represent components that are technically difficult to replicate and provide measurable operational advantage.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="diff-grid">
      <div class="diff-item">
        <span class="diff-num">01</span>
        <div>
          <h3>Terrain-Aware Reasoning</h3>
          <p>Canonical world frame + cost field propagation. Competitors use simple distance metrics; we model actual traversability.</p>
        </div>
      </div>
      <div class="diff-item">
        <span class="diff-num">02</span>
        <div>
          <h3>Dual-Path Behavioral Inference</h3>
          <p>Only system with parallel static + streaming behavioral inference. Enables both retrospective analysis and live tracking.</p>
        </div>
      </div>
      <div class="diff-item">
        <span class="diff-num">03</span>
        <div>
          <h3>Causal Evaluation Layer</h3>
          <p>D-effector + critically damped controller for stable, accurate evaluation.</p>
        </div>
      </div>
      <div class="diff-item">
        <span class="diff-num">04</span>
        <div>
          <h3>Air-Gap Operable</h3>
          <p>No external network dependencies. Deployable in classified environments. Competitors require cloud connectivity.</p>
        </div>
      </div>
    </div>

    <div class="stats" style="margin-top: 64px;">
      <div>
        <div class="stat-value">4</div>
        <div class="stat-label">Defensible Differentiators</div>
      </div>
      <div>
        <div class="stat-value">0</div>
        <div class="stat-label">External Network Calls</div>
      </div>
    </div>
  </section>
</Layout>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 32px;
    padding: 24px 5%;
    z-index: 100;
    background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
  }

  nav a {
    text-transform: uppercase;
    letter-spacing: 1.17px;
    font-size: 12px;
    font-weight: 700;
  }

  .content-section {
    background: var(--space-black);
    padding: 80px 5%;
  }

  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .diff-item {
    display: flex;
    gap: 24px;
    padding: 32px;
    background: var(--ghost-surface);
    border: 1px solid var(--ghost-border);
    border-radius: 16px;
  }

  .diff-num {
    font-size: 48px;
    font-weight: 700;
    opacity: 0.15;
  }

  h3 {
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  p {
    font-size: 14px;
    opacity: 0.7;
    line-height: 1.6;
  }

  .stats {
    display: flex;
    gap: 64px;
  }

  @media (max-width: 768px) {
    .diff-grid { grid-template-columns: 1fr; }
    .stats { flex-direction: column; gap: 32px; }
  }
</style>