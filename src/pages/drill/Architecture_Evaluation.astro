---
import Layout from '../../layouts/Layout.astro';
---

<script>
if (!sessionStorage.getItem('sthenos_auth')) {
  window.location.href = '/';
}
</script>

<Layout title="Architecture: Evaluation - Sthenos">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">

  <nav>
    <a href="/">Sthenos</a>
    <a href="/dashboard">Dashboard</a>
    <a href="/drill">Drill</a>
    <a href="/drill/Architecture">Architecture</a>
  </nav>

  <div class="header">
    <div style="display:flex;align-items:center">
      <h1>Evaluation</h1>
      <span class="breadcrumb">Architecture → <a href="/drill/Architecture_Evaluation">Evaluation</a></span>
    </div>
    <div class="header-meta">
      <span class="stat-chip">167 files</span>
      <span class="stat-chip">34 classes</span>
      <span class="stat-chip">118 functions</span>
      <span class="stat-chip">156 edges</span>
    </div>
  </div>

  <nav class="nav">
    <a href="/drill/Architecture">Overview</a>
    <a href="/drill/Architecture_Core">Core</a>
    <a href="/drill/Architecture_Enrichment">Enrichment</a>
    <a href="/drill/Architecture_Ingestion">Ingestion</a>
    <a href="/drill/Architecture_IO">IO</a>
    <a href="/drill/Architecture_Pipeline">Pipeline</a>
    <a href="/drill/Architecture_Roles">Roles</a>
    <a href="/drill/Architecture_Evaluation" class="active">Evaluation</a>
    <a href="/drill/Architecture_Evaluation_Metrics">Eval Metrics</a>
    <a href="/drill/Architecture_Evaluation_Splits">Eval Splits</a>
    <a href="/drill/Architecture_Evaluation_Stability">Eval Stability</a>
    <a href="/drill/Architecture_CLI">CLI</a>
  </nav>

  <div class="container">
    <div class="card">
      <h2>Evaluation has been split into 3 pages</h2>
      <p>Select a category below to explore that aspect of the Evaluation module.</p>
      <div class="links">
        <a href="/drill/Architecture_Evaluation_Metrics" class="btn">Metrics &amp; Reporting</a>
        <a href="/drill/Architecture_Evaluation_Splits" class="btn">Data Splits &amp; Ground Truth</a>
        <a href="/drill/Architecture_Evaluation_Stability" class="btn">Stability &amp; Validation</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  :root{--primary:#06b6d4;--bg-dark:#0f172a;--bg-card:rgba(30,41,59,0.7);--border:rgba(255,255,255,0.1);--text-main:#f8fafc;--text-dim:#94a3b8;--accent:#22d3ee}
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Outfit',sans-serif;background-color:var(--bg-dark);background-image:radial-gradient(at 0% 0%, rgba(6,182,212,0.15) 0px, transparent 50%),radial-gradient(at 100% 100%, rgba(34,211,238,0.1) 0px, transparent 50%);color:var(--text-main);min-height:100vh}
  .header{position:fixed;top:20px;left:20px;right:20px;z-index:1000;background:var(--bg-card);backdrop-filter:blur(12px);padding:12px 24px;border-radius:16px;border:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
  .header h1{font-size:16px;font-weight:600;background:linear-gradient(135deg,#06b6d4,#22d3ee);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
  .header-meta{display:flex;gap:16px;font-size:12px;color:var(--text-dim)}
  .stat-chip{background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.3);padding:4px 10px;border-radius:20px;font-size:11px}
  .breadcrumb{font-size:12px;color:var(--text-dim);margin-left:16px}
  .breadcrumb a{color:var(--text-dim);text-decoration:none}
  .breadcrumb a:hover{color:var(--text-main)}
  .nav{position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:1000;display:flex;gap:4px;background:var(--bg-card);backdrop-filter:blur(12px);padding:6px 12px;border-radius:12px;border:1px solid var(--border);font-size:11px}
  .nav a{color:var(--text-dim);text-decoration:none;padding:5px 10px;border-radius:6px;transition:all 0.2s}
  .nav a:hover{background:rgba(255,255,255,0.1);color:var(--text-main)}
  .nav a.active{background:#06b6d4;color:white}
  nav{position:fixed;top:0;left:0;right:0;display:flex;gap:24px;padding:24px 5%;z-index:100;background:linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%)}
  nav a{text-transform:uppercase;letter-spacing:1.17px;font-size:11px;font-weight:700}
  .container{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:100px 20px 20px}
  .card{text-align:center;background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:48px;max-width:600px}
  .card h2{font-size:24px;margin-bottom:12px;color:var(--primary)}
  .card p{color:var(--text-dim);margin-bottom:32px;line-height:1.6}
  .links{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  .btn{display:inline-block;padding:12px 24px;background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.4);border-radius:8px;color:var(--text-main);text-decoration:none;font-size:13px;transition:all 0.2s}
  .btn:hover{background:rgba(6,182,212,0.3);border-color:var(--primary)}
</style>
</Layout>
