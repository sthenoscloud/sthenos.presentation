    <a href="/drill/Architecture_Evaluation_Stability" >Eval Stability</a>
    <a href="/drill/Architecture_CLI" >CLI</a>
  </nav>

  <input class="search" id="search" placeholder="Search nodes..." oninput="filterNodes(this.value)">
  <div id="mynetwork"></div>

  <div class="panel" id="panel">
    <h3>Ingestion Components (50)</h3>
    <div id="cluster-list">
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">CanonicalWorldFrame</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">EntityWorldAdapter</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">InteractionEdge</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">RawPrimTrace</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">SignalConfidence</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">TerrainBrush</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">TerrainLOD</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">TickMetadata</span></div>
      <div class="cluster-row"><div class="cluster-dot" style="background:#f59e0b"></div><span class="cluster-name">TrajectoryWindow</span></div>
      <div class="cluster-row" style="color:var(--text-dim)">+40 more...</div>
    </div>
  </div>

  <div class="legend">
    <h3>Node Types</h3>
    <div class="legend-item"><div class="legend-shape" style="background:#f59e0b;border-radius:4px"></div> File / Module</div>
    <div class="legend-item"><div class="legend-shape" style="background:#1e293b;border-radius:50%;border:2px solid #f59e0b"></div> Class</div>
    <div class="legend-item"><div class="legend-shape" style="background:#0f172a;border:1px solid #475569;transform:rotate(45deg)"></div> Function</div>
    <div class="legend-item"><div style="width:30px;height:2px;background:#f472b6;border-radius:1px"></div> Cross-module import</div>
    <div class="legend-item"><div style="width:30px;height:2px;background:#f59e0b;opacity:0.4;border-radius:1px"></div> Contains / defines</div>
  </div>

