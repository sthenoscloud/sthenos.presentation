---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Architecture: Ingestion - Sthenos">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>

  <div class="header">
    <div style="display:flex;align-items:center">
      <h1>Ingestion</h1>
      <span class="breadcrumb">Architecture → <a href="/drill/Architecture">Ingestion</a></span>
    </div>
    <div class="header-meta">
      <span class="stat-chip">50 files</span>
      <span class="stat-chip">15 classes</span>
      <span class="stat-chip">28 functions</span>
      <span class="stat-chip">43 edges</span>
    </div>
  </div>

  <nav class="nav">
    <a href="/drill/Architecture">Overview</a>
    <a href="/drill/Architecture_Core">Core</a>
    <a href="/drill/Architecture_Enrichment" >Enrichment</a>
    <a href="/drill/Architecture_Ingestion" class="active">Ingestion</a>
    <a href="/drill/Architecture_IO" >IO</a>
    <a href="/drill/Architecture_Pipeline">Pipeline</a>
    <a href="/drill/Architecture_Roles" >Roles</a>
